<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- 1. Intercept carrier SMS signals as they hit the device radio -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- 2. Read local inbox for backup syncing and user verification -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- 3. Make HTTP POST requests to your Django ngrok link -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 4. Let WorkManager check if the phone is connected to cellular/WiFi -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 5. Required on Android 13+ to post background status alerts -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 6. Let the SMS interceptor re-activate if the phone is rebooted -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="VF-Cash Webhook Gateway"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        tools:targetApi="31">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- SMS Broadcast Receiver Registration -->
        <!-- Priority 999 ensures our app catches the SMS immediately -->
        <receiver
            android:name=".receivers.SmsReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>